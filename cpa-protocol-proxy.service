[Unit]
Description=CPA protocol proxy with NewAPI stream compatibility fix
After=network-online.target cliproxyapi.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cpa-protocol-proxy
EnvironmentFile=/etc/cpa-protocol-proxy.env
ExecStart=/opt/cpa-protocol-proxy/venv/bin/python /opt/cpa-protocol-proxy/cpa_protocol_proxy.py
Restart=always
RestartSec=2
TimeoutStopSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
